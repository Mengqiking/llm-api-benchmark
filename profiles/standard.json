{
  "suites": [
    "smoke",
    "reasoning",
    "latency",
    "cache"
  ],
  "timeout_seconds": 180,
  "input_sizes": [
    1024,
    8192
  ],
  "concurrency_levels": [
    1,
    4
  ],
  "samples_per_group": 5,
  "reasoning_samples": 3,
  "max_output_tokens": 64,
  "cache": {
    "mode": "auto",
    "cold_start_requests": 1,
    "warm_requests": 4,
    "unique_prefix_per_run": true,
    "varying_suffix": true,
    "stream": true
  }
}
