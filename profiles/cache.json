{
  "suites": [
    "cache"
  ],
  "timeout_seconds": 180,
  "input_sizes": [
    1024
  ],
  "concurrency_levels": [
    1
  ],
  "samples_per_group": 1,
  "reasoning_samples": 1,
  "max_output_tokens": 8,
  "cache": {
    "mode": "auto",
    "cold_start_requests": 1,
    "warm_requests": 4,
    "unique_prefix_per_run": true,
    "varying_suffix": true,
    "stream": true
  }
}
